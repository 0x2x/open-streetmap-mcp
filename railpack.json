{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "python -m pip install --upgrade pip",
        "pip install uv",
        "uv sync"
      ]
    },
    "build": {
      "inputs": [
        { "step": "install" }
      ],
      "commands": [
        "uv build"
      ]
    }
  },
  "deploy": {
    "startCommand": "uv run osm-mcp-server",
    "healthcheckPath": "/"
  }
}
