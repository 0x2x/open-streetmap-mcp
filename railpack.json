{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": [
        "python -m pip install --upgrade pip",
        "pip install -r requirements.txt"
      ]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": [
        "echo Build complete"
      ]
    }
  },
  "deploy": {
    "startCommand": "python app.py"
  }
}
