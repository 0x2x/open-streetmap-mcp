{
  "$schema": "https://schema.railpack.com",
  "provider": "python",
  "pythonVersion": "3.13",
  "steps": {
    "install": {
      "commands": [
        "python -m pip install --upgrade pip",
        "pip install uv",
        "uv sync"
      ]
    }
  },
  "deploy": {
    "startCommand": "uv run osm-mcp-server"
  }
}
